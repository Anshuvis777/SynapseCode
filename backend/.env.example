# ==================================================
# DevAssist AI — Environment Configuration
# ==================================================
# FREE stack: Groq API (LLM) + Ollama (embeddings only)
# No credit card required.
# ==================================================

# ---- Application ----
APP_NAME=DevAssist AI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ---- Authentication ----
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- PostgreSQL ----
POSTGRES_USER=devassist
POSTGRES_PASSWORD=devassist_secret
POSTGRES_DB=devassist_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devassist:devassist_secret@postgres:5432/devassist_db
DATABASE_URL_SYNC=postgresql+psycopg2://devassist:devassist_secret@postgres:5432/devassist_db

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Qdrant ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_CHUNKS=code_chunks
QDRANT_COLLECTION_MEMORIES=memories

# ==================================================
# LLM PROVIDER — Choose ONE
# ==================================================

# --- OPTION 1: Groq (RECOMMENDED — free, fast, no GPU needed) ---
# Get free API key at: https://console.groq.com (no credit card)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Pick a model based on your daily token budget:
#   llama-3.1-8b-instant    → 500k tokens/day (BEST for free tier)
#   llama-3.3-70b-versatile → 100k tokens/day (best quality)
#   mixtral-8x7b-32768      → 100k tokens/day
GROQ_LLM_MODEL=llama-3.1-8b-instant

# --- OPTION 2: Ollama (100% local, free, needs GPU or CPU) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# Run: docker compose exec ollama ollama pull llama3.2

# --- OPTION 3: OpenAI (paid) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_LLM_MODEL=gpt-4o

# ---- Embeddings (fastembed — local, low-RAM, default) ----
EMBEDDING_PROVIDER=fastembed

# ---- Embeddings (Hugging Face Serverless Inference API — FREE, low-RAM, cloud-based) ----
# Get free API key at: https://huggingface.co/settings/tokens (no credit card)
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
# HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Embeddings (Ollama — optional, free, local, needs Ollama container) ----
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- LLM Parameters (tuned for free tier token budget) ----
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TOP_K_CHUNKS=6
EMBEDDING_DIMENSIONS=768

# ---- Indexing ----
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_KB=1024
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_BATCH_SIZE=25

# ---- Storage ----
REPO_STORAGE_PATH=/app/storage/repos
DOCUMENT_STORAGE_PATH=/app/storage/documents
FASTEMBED_CACHE_PATH=/app/storage/cache
