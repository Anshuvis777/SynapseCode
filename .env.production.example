# ==============================================================================
# CodexRAG / DevAssist AI — Production Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="CodexRAG"
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Allowed Frontend Origins (Update with your production domain)
CORS_ORIGINS=http://localhost,https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# PostgreSQL Database (Internal Docker Network)
# Generate password with: openssl rand -hex 16
# ------------------------------------------------------------------------------
POSTGRES_USER=devassist_prod
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=devassist_prod_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devassist_prod:CHANGE_ME_TO_A_SECURE_PASSWORD@postgres:5432/devassist_prod_db
DATABASE_URL_SYNC=postgresql+psycopg2://devassist_prod:CHANGE_ME_TO_A_SECURE_PASSWORD@postgres:5432/devassist_prod_db

# ------------------------------------------------------------------------------
# Redis Cache & Task Broker (Internal Docker Network)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Qdrant Vector Database (Internal Docker Network)
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_CHUNKS=code_chunks
QDRANT_COLLECTION_MEMORIES=memories

# ------------------------------------------------------------------------------
# LLM & Embedding Settings (Zero-Retention BYOK Mode)
# Leave GROQ_API_KEY empty to enforce user-provided keys per request
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.1-8b-instant

EMBEDDING_PROVIDER=fastembed
EMBEDDING_DIMENSIONS=384
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TOP_K_CHUNKS=6

REPO_STORAGE_PATH=/app/storage/repos
DOCUMENT_STORAGE_PATH=/app/storage/documents
